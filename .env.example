# Firebase web config — copy to `.env` and fill in real values (or set them in
# the Vercel dashboard for deploys). These are NOT secrets: a Firebase web
# apiKey is always shipped to the client. Data is protected by Firestore
# Security Rules + Authorized domains + Google Cloud API-key restrictions,
# not by hiding these values. `.env` is gitignored; this template is committed.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
